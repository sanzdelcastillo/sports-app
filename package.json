{
  "name": "pitchside",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Pitchside \u2014 the week's games for the clubs you follow, with where to watch. Never streams video.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "check:access": "tsx scripts/validate-access.ts",
    "cap:sync": "npm run build && cap sync",
    "ios": "cap open ios",
    "android": "cap open android",
    "assets": "capacitor-assets generate --iconBackgroundColor \"#0E3C29\" --iconBackgroundColorDark \"#0E3C29\" --splashBackgroundColor \"#0E3C29\" --splashBackgroundColorDark \"#0E3C29\""
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
